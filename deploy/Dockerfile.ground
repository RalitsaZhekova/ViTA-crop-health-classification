# syntax=docker/dockerfile:1.7
ARG VITA_GROUND_BASE_IMAGE=python:3.12-slim-bookworm
FROM ${VITA_GROUND_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/vita/ground/src

WORKDIR /opt/vita
COPY deploy/requirements-ground.txt /tmp/requirements-ground.txt
RUN python -m pip install --no-cache-dir --requirement /tmp/requirements-ground.txt
COPY ground ./ground
RUN python -m pip check

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=2)" || exit 1
CMD ["python", "-m", "prithvi_ground.api", "--store", "/runtime/ground", "--host", "0.0.0.0", "--port", "8000"]
