# This is the NVIDIA Jetson/iGPU image whose framework stack was observed on the target.
# The payload probe must still confirm that its L4T host and NVIDIA runtime can launch it.
ARG VITA_PAYLOAD_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.01-py3-igpu
FROM ${VITA_PAYLOAD_BASE_IMAGE}

ARG VITA_PAYLOAD_BASE_IMAGE
LABEL org.opencontainers.image.title="ViTA crop MVP payload" \
      org.opencontainers.image.description="Warm CUDA/TensorRT GeoTIFF inference service for Jetson AGX Orin" \
      org.opencontainers.image.base.name="${VITA_PAYLOAD_BASE_IMAGE}"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    GDAL_CACHEMAX=512 \
    GDAL_NUM_THREADS=ALL_CPUS

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        gdal-bin \
        libgdal-dev \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/vita
COPY deploy/requirements-payload.txt /tmp/requirements-payload.txt
RUN set -eux; \
    : > /tmp/vita-constraint.txt; \
    if [ -f /etc/pip/constraint.txt ]; then \
        grep -viE '^[[:space:]]*numpy([[:space:]<>=!~]|$)' \
            /etc/pip/constraint.txt > /tmp/vita-constraint.txt || true; \
    fi; \
    printf 'numpy==1.26.4\n' >> /tmp/vita-constraint.txt; \
    python -m pip install --no-cache-dir --constraint /tmp/vita-constraint.txt \
        --requirement /tmp/requirements-payload.txt

COPY pyproject.toml ./
COPY payload ./payload
COPY shared ./shared
COPY integration ./integration
COPY ground ./ground
RUN python -m pip install --no-cache-dir --no-deps . \
    && python -m pip check \
    && python -c "import importlib.metadata as metadata, cv2, matplotlib, numpy, omnicloudmask, rasterio, scipy, segmentation_models_pytorch, tensorrt, terratorch, torch, torch_tensorrt; assert numpy.__version__ == '1.26.4', numpy.__version__; assert metadata.version('terratorch') == '1.1.1', metadata.version('terratorch'); assert metadata.version('segmentation-models-pytorch') == '0.5.0', metadata.version('segmentation-models-pytorch'); assert torch.__version__.startswith('2.6.0a0+ecf3bae40a'), torch.__version__; assert torch.version.cuda == '12.8', torch.version.cuda; assert tensorrt.__version__.startswith('10.8.'), tensorrt.__version__; assert torch_tensorrt.__version__.startswith('2.6.0a0'), torch_tensorrt.__version__; print('Validated payload stack:', numpy.__version__, metadata.version('terratorch'), cv2.__version__, rasterio.__version__, scipy.__version__, torch.__version__, torch.version.cuda, tensorrt.__version__)"

EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=5s --start-period=90m --retries=6 \
    CMD curl --fail --silent http://127.0.0.1:8090/healthz >/dev/null || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["vita-payload-server"]
