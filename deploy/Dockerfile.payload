# This is the NVIDIA Jetson/iGPU image whose framework stack was observed on the target.
# The payload probe must still confirm that its L4T host and NVIDIA runtime can launch it.
ARG VITA_PAYLOAD_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.01-py3-igpu
FROM ${VITA_PAYLOAD_BASE_IMAGE}

ARG VITA_PAYLOAD_BASE_IMAGE
LABEL org.opencontainers.image.title="ViTA crop MVP payload" \
      org.opencontainers.image.description="Warm CUDA/TensorRT GeoTIFF inference service for Jetson AGX Orin" \
      org.opencontainers.image.base.name="${VITA_PAYLOAD_BASE_IMAGE}"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    GDAL_CACHEMAX=512 \
    GDAL_NUM_THREADS=ALL_CPUS

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        gdal-bin \
        libgdal-dev \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/vita
COPY deploy/requirements-payload.txt /tmp/requirements-payload.txt
RUN set -eux; \
    : > /tmp/vita-constraint.txt; \
    if [ -f /etc/pip/constraint.txt ]; then \
        grep -viE '^[[:space:]]*numpy([[:space:]<>=!~]|$)' \
            /etc/pip/constraint.txt > /tmp/vita-constraint.txt || true; \
    fi; \
    printf 'numpy==1.26.4\n' >> /tmp/vita-constraint.txt; \
    python -m pip install --no-cache-dir --constraint /tmp/vita-constraint.txt \
        --requirement /tmp/requirements-payload.txt

COPY pyproject.toml ./
COPY payload ./payload
COPY shared ./shared
COPY integration ./integration
COPY ground ./ground
RUN python -m pip install --no-cache-dir --no-deps . \
    && python -m pip check \
    && python -c "import importlib.metadata as metadata, cv2, matplotlib, numpy, omnicloudmask, onnx, onnxscript, rasterio, scipy, segmentation_models_pytorch, tensorrt, terratorch, torch; from prithvi_payload.cloud_classifier import DEFAULT_CLOUD_CONFIG; assert DEFAULT_CLOUD_CONFIG.is_file(), DEFAULT_CLOUD_CONFIG; assert numpy.__version__ == '1.26.4', numpy.__version__; assert onnx.__version__ == '1.17.0', onnx.__version__; assert onnxscript.__version__ == '0.1.0', onnxscript.__version__; assert metadata.version('terratorch') == '1.1.1', metadata.version('terratorch'); assert metadata.version('torchgeo') == '0.7.1', metadata.version('torchgeo'); assert metadata.version('lightly') == '1.5.22', metadata.version('lightly'); assert metadata.version('segmentation-models-pytorch') == '0.5.0', metadata.version('segmentation-models-pytorch'); assert torch.__version__.startswith('2.6.0a0+ecf3bae40a'), torch.__version__; assert torch.version.cuda == '12.8', torch.version.cuda; assert tensorrt.__version__.startswith('10.8.'), tensorrt.__version__; print('Validated direct TensorRT build stack:', numpy.__version__, onnx.__version__, onnxscript.__version__, torch.__version__, torch.version.cuda, tensorrt.__version__, DEFAULT_CLOUD_CONFIG)" \
    && { trtexec_path="$(command -v trtexec || true)"; if [ -z "$trtexec_path" ]; then for candidate in /opt/tensorrt/bin/trtexec /usr/src/tensorrt/bin/trtexec; do if [ -x "$candidate" ]; then trtexec_path="$candidate"; break; fi; done; fi; test -x "$trtexec_path"; "$trtexec_path" --help >/dev/null; }

ARG VITA_PAYLOAD_UID=2002
ARG VITA_PAYLOAD_GID=2002
RUN set -eux; \
    if ! getent group "${VITA_PAYLOAD_GID}" >/dev/null; then \
        groupadd --gid "${VITA_PAYLOAD_GID}" vita-payload; \
    fi; \
    if ! getent passwd "${VITA_PAYLOAD_UID}" >/dev/null; then \
        useradd --uid "${VITA_PAYLOAD_UID}" --gid "${VITA_PAYLOAD_GID}" \
            --home-dir /home/vita --no-create-home --shell /bin/false vita-payload; \
    fi; \
    install -d -m 0700 -o "${VITA_PAYLOAD_UID}" -g "${VITA_PAYLOAD_GID}" /home/vita; \
    getent passwd "${VITA_PAYLOAD_UID}"

ENV HOME=/home/vita \
    LOGNAME=vita-payload \
    USER=vita-payload \
    XDG_CACHE_HOME=/home/vita/.cache
USER ${VITA_PAYLOAD_UID}:${VITA_PAYLOAD_GID}
RUN python -c "import getpass, os, pwd; record = pwd.getpwuid(os.getuid()); assert record.pw_uid == int('${VITA_PAYLOAD_UID}'), record; assert record.pw_gid == int('${VITA_PAYLOAD_GID}'), record; assert getpass.getuser() == 'vita-payload', getpass.getuser(); print('Validated runtime identity:', record)"

EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=5s --start-period=90m --retries=6 \
    CMD curl --fail --silent http://127.0.0.1:8090/healthz >/dev/null || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["vita-payload-server"]
