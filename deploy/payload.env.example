VITA_PAYLOAD_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.01-py3-igpu
VITA_PAYLOAD_IMAGE=vita-payload:1.0.0
VITA_PAYLOAD_PORT=8090
VITA_CROP_BACKEND=tensorrt
VITA_TRT_STRICT=1
VITA_TRT_REQUIRE_FULL=0
VITA_TRT_OPTIMIZATION_LEVEL=3
VITA_CLOUD_INFERENCE_DTYPE=fp16
VITA_CLOUD_BATCH_SIZE=2
# The fixed Balkan proof-of-concept grid uses 869 px model patches after the
# reviewed OmniCloudMask no-data adjustment. Sentinel's 1000 px profile is
# always warmed automatically.
VITA_CLOUD_WARMUP_PATCH_SIZES=869
VITA_BALKAN_PREPARE_INPUT=balkan1/preprocessed/3408_L1ORT.tif
VITA_BALKAN_OVERVIEW_FAST_PATH=1
# Fail readiness instead of silently paying the full-resolution 12-13 second warp.
VITA_BALKAN_OVERVIEW_REQUIRED=1
VITA_BALKAN_PREP_MAX_BYTES=2147483648
VITA_WARMUP=1
VITA_CPU_THREADS=8
VITA_WEBP_METHOD=3
VITA_PNG_COMPRESSION_LEVEL=4
