VITA_PAYLOAD_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.01-py3-igpu
# Exact image ID verified on the JetPack 7.2 Orin on 2026-08-07.
VITA_EXPECTED_BASE_IMAGE_ID=sha256:912d7d7591fc0957092ef202b747b78ba883ca50e5e71781aa8505d9f6a12f6b
VITA_PAYLOAD_IMAGE=vita-payload:1.0.0
VITA_PAYLOAD_PORT=8090
VITA_CROP_BACKEND=tensorrt
VITA_CROP_BATCH_SIZE=16
# Preserve FP32 model I/O while TensorRT selects FP16 tactics internally. The
# offline parity reference is the established PyTorch CUDA-autocast execution.
VITA_CROP_TRT_PRECISION=mixed-fp16
VITA_TRT_CUDAGRAPHS=0
VITA_CLOUD_BACKEND=tensorrt
# OmniCloudMask's operational CUDA baseline is FP16; the direct TensorRT plans
# are strongly typed FP16 and must pass all-four-scene semantic parity.
VITA_CLOUD_INFERENCE_DTYPE=fp16
VITA_CLOUD_TRT_PRECISION=fp16
VITA_CLOUD_BATCH_SIZE=4
VITA_TRT_WORKSPACE_MIB=4096
# Spend the maximum offline search effort once; timing caches and checksummed
# plans make subsequent identical deployments reusable.
VITA_TRT_BUILDER_OPTIMIZATION_LEVEL=5
# The two 700 px Sentinel scenes and the Balkan grids' 869/891 px no-data
# adjustments are the complete reviewed production model-input shapes.
VITA_CLOUD_WARMUP_PATCH_SIZES=700,869,891
VITA_BALKAN_PREPARE_INPUTS=balkan1/preprocessed/3370_L1ORT.tif,balkan1/preprocessed/3408_L1ORT.tif
VITA_DEMO_SENTINEL_IMAGES=sentinel2/S2_20260610T091331_T35TLG_bulgaria-thrace.tif,sentinel2/S2_20260115T135659_T21LXF_brazil-mato-grosso.tif
VITA_BALKAN_OVERVIEW_FAST_PATH=1
# Fail readiness instead of silently paying the full-resolution 12-13 second warp.
VITA_BALKAN_OVERVIEW_REQUIRED=1
VITA_BALKAN_PREP_MAX_BYTES=2147483648
VITA_WARMUP=1
VITA_CPU_THREADS=8
VITA_CONDITION_TILE_SIZE=4096
VITA_CONDITION_METRIC_THREADS=8
VITA_CONDITION_EXACT_PERCENTILES=1
VITA_CROP_IN_MEMORY=1
VITA_CROP_IN_MEMORY_MAX_BYTES=1073741824
VITA_DOWNLINK_GRID_IN_MEMORY=1
VITA_DOWNLINK_GRID_IN_MEMORY_MAX_BYTES=536870912
VITA_DOWNLINK_GRID_THREADS=8
# Intermediate science rasters are transient on the timed MVP path. Keeping
# them uncompressed avoids compression/decompression CPU work before downlink.
VITA_FAST_INTERMEDIATE_RASTERS=1
# The service only transmits scene.json, scene.webp and condition.png. Keep
# crop/condition handoffs in RAM instead of writing non-downlinked rasters.
VITA_COMPACT_PAYLOAD_PIPELINE=1
VITA_WEBP_METHOD=0
VITA_PNG_COMPRESSION_LEVEL=1
VITA_PERFORMANCE_REPETITIONS=3
VITA_SKIP_PERFORMANCE_ACCEPTANCE=0
