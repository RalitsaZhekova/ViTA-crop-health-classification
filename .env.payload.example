EE_PROJECT_ID=REPLACE_WITH_GOOGLE_CLOUD_PROJECT_ID
EE_CREDENTIALS_FILE=./secrets/earth-engine.json

CUDA_REQUIRED=1
VITA_PAYLOAD_IMAGE=vita-payload:0.1.0
VITA_PAYLOAD_BASE_IMAGE=REPLACE_WITH_COMPATIBLE_BASE_IMAGE
VITA_CONTAINER_UID=1000
VITA_CONTAINER_GID=1000

VITA_MAX_CONCURRENT_JOBS=1
EE_MAX_CANDIDATES=50
EE_MAX_SCENE_ATTEMPTS=5
