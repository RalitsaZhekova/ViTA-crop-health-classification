{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vita.example/schemas/inference-result-v1.json",
  "title": "Payload inference result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "sensor",
    "acquired_at",
    "model_sha256",
    "raster_assets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "sensor": {"enum": ["sentinel-2", "balkan-1"]},
    "acquired_at": {"type": "string", "format": "date-time"},
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "crs": {"type": "string"},
    "bounds": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "raster_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fine_class", "crop_binary", "crop_probability", "cloud_mask"],
      "properties": {
        "fine_class": {"type": "string"},
        "crop_binary": {"type": "string"},
        "crop_probability": {"type": "string"},
        "cloud_mask": {"type": "string"}
      }
    }
  }
}
