{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vita.example/schemas/downlink-bundle-v1.json",
  "title": "Compact crop-condition downlink bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_type",
    "algorithm_version",
    "scene_id",
    "region_id",
    "sensor",
    "acquired_at",
    "status",
    "claim",
    "source",
    "assets",
    "geospatial",
    "quality",
    "metrics",
    "condition",
    "interaction_grid",
    "legend",
    "processing",
    "limitations",
    "warnings",
    "package"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "product_type": {"const": "vita.crop-condition.web-bundle"},
    "algorithm_version": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "minLength": 1},
    "sensor": {"enum": ["sentinel-2", "balkan-1"]},
    "acquired_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["MEASURED", "INSUFFICIENT_DATA"]},
    "claim": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "payload_measured_thick_cloud_percentage",
        "payload_measured_thin_cloud_percentage",
        "payload_measured_shadow_percentage",
        "payload_measured_cloud_percentage",
        "payload_measured_unusable_percentage"
      ],
      "properties": {
        "provider": {"enum": ["local_file", "earth_engine"]},
        "collection": {"type": "string"},
        "provider_scene_id": {"type": "string"},
        "product_id": {"type": ["string", "null"]},
        "acquired_at": {"type": ["string", "null"], "format": "date-time"},
        "requested_bbox_wgs84": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "source_crs": {"type": "string"},
        "source_transform": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 6,
          "maxItems": 6
        },
        "source_scale": {"type": "number", "const": 10000},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_bytes": {"type": "integer", "minimum": 1},
        "selection_policy": {"enum": ["target_cloud_range", "least_cloudy"]},
        "target_cloud_range": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["minimum_percent", "maximum_percent", "ideal_percent"],
          "properties": {
            "minimum_percent": {"type": "number", "minimum": 5, "maximum": 50},
            "maximum_percent": {"type": "number", "minimum": 5, "maximum": 50},
            "ideal_percent": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "earth_engine_metadata_cloud_percentage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "candidate_rank": {"type": "integer", "minimum": 1},
        "candidate_attempt_count": {"type": "integer", "minimum": 1, "maximum": 5},
        "resampling_policy": {"const": "earth_engine_default_nearest"},
        "payload_measured_thick_cloud_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "payload_measured_thin_cloud_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "payload_measured_shadow_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "payload_measured_cloud_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "payload_measured_unusable_percentage": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "earth_engine"}}},
          "then": {
            "required": [
              "collection",
              "provider_scene_id",
              "product_id",
              "acquired_at",
              "requested_bbox_wgs84",
              "source_crs",
              "source_transform",
              "source_scale",
              "source_sha256",
              "source_bytes",
              "selection_policy",
              "target_cloud_range",
              "earth_engine_metadata_cloud_percentage",
              "candidate_rank",
              "candidate_attempt_count",
              "resampling_policy"
            ]
          }
        }
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb_preview", "condition_overlay"],
      "properties": {
        "rgb_preview": {"$ref": "#/$defs/imageAsset"},
        "condition_overlay": {"$ref": "#/$defs/imageAsset"}
      }
    },
    "geospatial": {"type": "object"},
    "quality": {"type": "object"},
    "metrics": {"type": "object"},
    "condition": {"type": "object"},
    "interaction_grid": {
      "type": "object",
      "required": ["rows", "columns", "cell_order", "cells"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "cell_order": {"type": "string"},
        "cells": {"type": "array", "items": {"type": "object"}}
      }
    },
    "legend": {"type": "object"},
    "processing": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "package": {
      "type": "object",
      "required": ["file_count", "metadata_file", "asset_bytes", "metadata_bytes", "total_bytes"],
      "properties": {
        "file_count": {"const": 3},
        "metadata_file": {"const": "scene.json"},
        "asset_bytes": {"type": "integer", "minimum": 1},
        "metadata_bytes": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "media_type", "width", "height", "bytes", "sha256"],
      "properties": {
        "href": {"type": "string", "minLength": 1},
        "media_type": {"enum": ["image/webp", "image/png"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
