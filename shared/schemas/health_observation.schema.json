{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vita.example/schemas/health-observation-v1.json",
  "title": "Ground health observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm_version",
    "scene_id",
    "region_id",
    "sensor",
    "acquired_at",
    "status",
    "quality",
    "metrics",
    "condition",
    "raster_assets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm_version": {"type": "string"},
    "scene_id": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "minLength": 1},
    "sensor": {"enum": ["sentinel-2", "balkan-1"]},
    "acquired_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["MEASURED", "INSUFFICIENT_DATA"]},
    "quality": {
      "type": "object",
      "required": ["total_pixels", "analysis_pixels", "analysis_percentage"],
      "properties": {
        "total_pixels": {"type": "integer", "minimum": 0},
        "analysis_pixels": {"type": "integer", "minimum": 0},
        "analysis_percentage": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "metrics": {"type": "object"},
    "condition": {
      "type": "object",
      "required": [
        "status",
        "label",
        "condition_score",
        "evidence_quality_score",
        "analysis_pixels",
        "analysis_percentage",
        "explanations",
        "limitations"
      ],
      "properties": {
        "status": {"enum": ["MEASURED", "INSUFFICIENT_DATA"]},
        "label": {
          "enum": [
            "Nominal",
            "Watch",
            "Moderate anomaly",
            "High anomaly",
            "Insufficient data"
          ]
        },
        "condition_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "evidence_quality_score": {"type": "number", "minimum": 0, "maximum": 100},
        "analysis_pixels": {"type": "integer", "minimum": 0},
        "analysis_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "explanations": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "raster_assets": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "index_algorithm_version": {"type": "string"},
    "condition_algorithm_version": {"type": "string"},
    "geospatial": {"type": "object"},
    "radiometry": {"type": "object"},
    "provenance": {"type": "object"},
    "runtime": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
